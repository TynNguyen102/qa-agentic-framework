# Copy to .env only on a trusted local machine and run: chmod 600 .env
# Never commit real credentials or tokens.

# ============================================================================
# Example-Project (Projects/Example-Project/) — Jira key SP
# ============================================================================

# --- Jira / Confluence (Atlassian) --------------------------------------
# Auth is via Atlassian MCP OAuth in the session (mcp__claude_ai_Atlassian__*),
# NOT via these vars — they are config/reference only, no credential needed.
ATLASSIAN_SITE_URL=https://YOUR-SITE.atlassian.net
JIRA_PROJECT_KEY=SP
JIRA_BOARD_URL=https://YOUR-SITE.atlassian.net/jira/software/c/projects/SP/boards/898
CONFLUENCE_SPACE_KEY=KE
CONFLUENCE_SPACE_ALIAS=kom
CONFLUENCE_ROOT_PAGE_URL=https://YOUR-SITE.atlassian.net/wiki/spaces/kom/pages/48465909/Example+Platform

# --- TestRail -------------------------------------------------------------
# Base URL confirmed 2026-08-25. Auth = API key (HTTP Basic: username:api_key),
# confirmed working 2026-08-26 — generate at
# https://your-org.testrail.io/index.php?/mysettings (tab API Keys). Do not use a
# personal login password here.
TESTRAIL_BASE_URL=https://your-org.testrail.io
TESTRAIL_USERNAME=
TESTRAIL_API_KEY=

# --- GitLab -----------------------------------------------------------
# Personal Access Token scope (verified live 2026-08-27): read_user, read_api, api,
# read_repository, write_repository, read_virtual_registry — expires 2027-01-31.
# NOTE: api + write_repository means this token CAN push and create projects.
# Do not paste the
# token in chat. Covers <QC-GROUP> (group, 17 sub-repos),
# soc-platform/SPEC-REPO, soc-platform/PRODUCT-REPO.
GITLAB_BASE_URL=https://gitlab.example.local
GITLAB_TOKEN=
GITLAB_QC_GROUP_URL=https://gitlab.example.local/<GROUP>/<QC-GROUP>
# Parent group of SPEC-REPO/PRODUCT-REPO — 45 sub-repos total. ALWAYS search here FIRST:
# GET /api/v4/groups/YOUR-GROUP%2FYOUR-SUBGROUP/search?scope=blobs&search=<keyword>
GITLAB_SOC_PLATFORM_GROUP_URL=https://gitlab.example.local/YOUR-GROUP/YOUR-SUBGROUP
GITLAB_BA_SPEC_REPO_URL=https://gitlab.example.local/YOUR-GROUP/YOUR-SUBGROUP/SPEC-REPO
GITLAB_DEV_REPO_URL=https://gitlab.example.local/YOUR-GROUP/YOUR-SUBGROUP/PRODUCT-REPO
# specs/ folder in PRODUCT-REPO: ~90 feature spec-kit docs, often more detailed than SPEC-REPO's BA
# docs — check here before concluding a requirement gap.
GITLAB_DEV_SPECS_URL=https://gitlab.example.local/YOUR-GROUP/YOUR-SUBGROUP/PRODUCT-REPO/-/tree/main/specs

# --- Example-Project application (system under test) — DEV/PROD ------------
# URL confirmed 2026-08-26. Login account (username/password) not given yet —
# do not guess/invent values.
PLATFORM_DEV_URL=https://dev-app.example.local
PLATFORM_DEV_LOGIN_URL=https://dev-app.example.local/api/auth/signin?csrf=true
PLATFORM_DEV_AUTH_METHOD=YOUR-ORG_ad_sso
PLATFORM_DEV_USERNAME= 
PLATFORM_DEV_PASSWORD= 
PLATFORM_PROD_URL=https://app.example.com
qauser01=<mat-khau-test-chi-de-trong-.env>
qauser02=<mat-khau-test-chi-de-trong-.env>
qauser03=<mat-khau-test-chi-de-trong-.env>
qauser04=<mat-khau-test-chi-de-trong-.env>
qauser05=<mat-khau-test-chi-de-trong-.env>
qauser06=<mat-khau-test-chi-de-trong-.env>
NEXTAUTH_SECRET=  # <-- lay tu dev, chi dat trong .env (da gitignore), KHONG dien vao file .example nay
client_secret=<keycloak-client-secret-chi-de-trong-.env>
# QC KHONG dung PROD — PROD chi smoke thu cong sau go-live, khong test intrusive/destructive.
# Xem README muc 0.7. Hai bien duoi de trong CO CHU DICH; dung dien vao.
# PLATFORM_PROD_USERNAME=
# PLATFORM_PROD_PASSWORD=

# --- Database DEV -----------------------------------------------------------
# Them 2026-08-28. Truoc do khong co khoi nay, hau qua: credential DB bi hardcode
# trong <PENTEST-REPO>/automation/config/config.yaml — tuc la nam trong git. Dien vao day,
# KHONG hardcode vao repo.
# Trang thai 2026-08-28: chua ket noi duoc. Khong phai thieu tai khoan ma la firewall
# chan cong database di ra tu dai may nhan vien (do thay 5432 va 8443 timeout, 443 OK).
# Xem Team/IT-REQUEST.md muc C.1.
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# Write role, CUNG DB voi PG_DATABASE o tren (== Postgresconfig_edit trong <PENTEST-REPO>/automation/
# config/config.py). Ten bien khac PG_USER/PG_PASSWORD de khong dung do voi role readonly.
# Chi dung cho script can INSERT/UPDATE that, KHONG dung cho query kiem tra.
PG_USER_WRITE=
PG_PASSWORD_WRITE=

# Write role rieng cho Postgres `cmdb` (OT asset: ot_asset/ot_asset_assessment) -- ==
# Postgresconfig_cmdb_edit trong config.py goc. Chi dung cho seed/sua fake-data test
# delete-flow/update-flow, KHONG dung cho query thong thuong.
PG_DATABASE_CMDB=
PG_USER_CMDB=
PG_PASSWORD_CMDB=

MONGO_URI=
MONGO_DB=

# Write role (cmdb) -- == Mongo_edit trong config.py goc. URI phai gom san user/password/db
# (dang mongodb+srv://<user>:<password>@<host>/<db>). Chi dung khi can insert/update fake-data.
MONGO_URI_WRITE=

CH_HOST=
CH_PORT=8443
CH_USER=
CH_PASSWORD=
CH_DATABASE=

# Role rieng: Activity Ledger (DB activity_ledger, khac CH_DATABASE o tren) -- ==
# ClickHouse_Activity_log trong config.py goc.
CH_USER_ACTIVITY=
CH_PASSWORD_ACTIVITY=
CH_DATABASE_ACTIVITY=

# Role rieng: CMDB tren ClickHouse (DB cmdb -- KHAC Postgres cmdb va Mongo cmdb, trung ten
# khac engine) -- == ClickHouse_CMDB trong config.py goc.
CH_USER_CMDB=
CH_PASSWORD_CMDB=
CH_DATABASE_CMDB=

# Write role, CUNG DB voi CH_DATABASE o tren (khac readonly CH_USER/CH_PASSWORD) -- ==
# ClickHouse_endpoint_edit trong config.py goc.
CH_USER_WRITE=
CH_PASSWORD_WRITE=

REDIS_HOST=

# --- SSH bastion (duong vao DB) --------------------------------------------
# Dien khi team Ha tang cap. Bo automation da ho tro san qua thu vien sshtunnel
# (xem <AUTOTEST-REPO>, linhln18-auto). DBeaver co san tab SSH, khong can cai them gi.
# KHONG commit file .pem vao repo — de ngoai workspace, vi du ~/.ssh/
SSH_TUNNEL_HOST=
SSH_TUNNEL_PORT=22
SSH_TUNNEL_USER=
SSH_PEM_KEY_PATH=

# --- Cert noi bo cho npm / pip ---------------------------------------------
# Cert <INTERNAL-ROOT-CA> chan Node/Python tai file qua HTTPS. Khong co bien nay
# thi npm install bao SELF_SIGNED_CERT_IN_CHAIN. Xem Team/SETUP-GUIDE.md buoc 2.
NODE_EXTRA_CA_CERTS=
